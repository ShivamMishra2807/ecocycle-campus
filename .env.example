# Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecocycle_db?schema=public"

# Auth Secrets
JWT_SECRET="ecocycle-super-secret-jwt-key-2026-campus-auth"
JWT_REFRESH_SECRET="ecocycle-super-secret-refresh-key-2026-campus-auth"
JWT_EXPIRES_IN="7d"

# Server Port
PORT=5000

# Next.js Frontend URL & API URL
CORS_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:5000/api/v1"

# Environment
NODE_ENV="development"
